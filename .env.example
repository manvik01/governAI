# Copy to .env (never commit .env). Values here are read by compose.yaml and deploy/onprem/compose.yaml.

# 32 random bytes, base64, used to encrypt backups. Generate: openssl rand -base64 32
# Store it outside this server too: without it, backups cannot be restored.
ZENAI4_BACKUP_KEY=

# Requests per minute allowed per agent or user (default 120).
# RATE_LIMIT_PER_MIN=120

# Local setup only: host port (bound to 127.0.0.1).
# ZENAI4_PORT=8787

# On-premises setup only: the DNS name clients use to reach the gateway.
# ZENAI4_HOSTNAME=zenai4.internal.example.com

# ---- Database (phase 1). Bundled Postgres on this VM by default.
# Remove bundled-db to use your own Postgres or Supabase, and set the two URLs below.
COMPOSE_PROFILES=bundled-db
# Generate each with: openssl rand -base64 24
ZENAI4_DB_OWNER_PASSWORD=
ZENAI4_DB_APP_PASSWORD=
# Optional: read-only role for BI tools.
# ZENAI4_DB_REPORT_PASSWORD=
# External database only (Supabase: use the session pooler string; owner = postgres, app = zenai4_app):
# ZENAI4_MIGRATE_DATABASE_URL=postgres://postgres:...@host:5432/postgres
# DATABASE_URL=postgres://zenai4_app:...@host:5432/postgres
# Supabase migrations are applied with `supabase db push`, so the migrate step only checks status there.

# ---- Intake
# Token printed by: docker compose exec intake zenai4-admin source add collector --kind otlp
ZENAI4_COLLECTOR_TOKEN=
# Secret used to pseudonymise user ids in logs. Generate: openssl rand -base64 24
ZENAI4_PSEUDONYM_SALT=
# Folder of agent JSON log files for the Collector to tail (read-only).
# ZENAI4_AGENT_LOG_DIR=/var/log/my-agents
