# Copy to .env (never commit .env). Values here are read by compose.yaml and deploy/onprem/compose.yaml.

# 32 random bytes, base64, used to encrypt backups. Generate: openssl rand -base64 32
# Store it outside this server too: without it, backups cannot be restored.
ZENAI4_BACKUP_KEY=

# Requests per minute allowed per agent or user (default 120).
# RATE_LIMIT_PER_MIN=120

# Local setup only: host port (bound to 127.0.0.1).
# ZENAI4_PORT=8787

# On-premises setup only: the DNS name clients use to reach the gateway.
# ZENAI4_HOSTNAME=zenai4.internal.example.com

# ---- deploy/vm only (single VM with the trimmed Supabase stack) -------------------
# Password for the Postgres superuser in the db service. Generate: openssl rand -base64 32
# Never commit the real value. The ZenAi4 roles (zenai4_app, zenai4_report) get their
# passwords by hand after the migrations run (see docs/deployment/vm.md).
# POSTGRES_PASSWORD=
# Loopback ports for Postgres and Studio (reach them with an SSH tunnel).
# POSTGRES_PORT=5432
# STUDIO_PORT=3000
# Intake-source token for the bundled OpenTelemetry Collector (profile "collector").
# Create it with: docker compose exec gateway zenai4-admin source add --name otel-vm1 --as you@company.com
# ZENAI4_SOURCE_TOKEN=

# ---- telemetry (phase 1.1), all optional; defaults shown --------------------------
# ZENAI4_INTAKE_CAPTURE_MODE=metadata        # none | metadata | redacted (for agent-credential intake; sources set their own)
# ZENAI4_INTAKE_MAX_BYTES=1048576            # per batch, after decompression
# ZENAI4_INTAKE_MAX_STEPS=1000               # per batch
# ZENAI4_INTAKE_RATE_LIMIT_PER_MIN=600       # per source or agent
# ZENAI4_PAYLOAD_MAX_CHARS=4096              # redacted payloads are truncated to this
# ZENAI4_CAPTURE_REASONING=0                 # 1 = keep (redacted) reasoning text in "redacted" mode
# ZENAI4_PII_REDACT=email,phone,card,national_id
# ZENAI4_PAYLOAD_RETENTION_DAYS=30
# ZENAI4_RECONCILE_INTERVAL_HOURS=1
# ZENAI4_DRIFT_MODE=alert_only               # alert_only | enforce_review
# ZENAI4_DORMANT_DAYS=30
# ZENAI4_VIOLATION_THRESHOLD=5               # deny decisions per window that raise the tier (0 = off)
# ZENAI4_VIOLATION_WINDOW_DAYS=30
# ZENAI4_VIOLATION_RAISE_TIER=high           # medium | high | critical
# ZENAI4_GAP_GRACE_MINUTES=10                # wait this long after a session's last step before reporting gaps
