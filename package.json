{
  "name": "agent-governance-poc",
  "version": "0.1.0",
  "description": "Proof-of-concept: governance control plane for AI agents (registry, policy engine, gateway, evidence ledger)",
  "type": "module",
  "main": "dist/demo/scenario.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node dist/demo/scenario.js",
    "server": "npm run build && node dist/gateway/server.js",
    "mcp:server": "npm run build && node dist/mcp/server.js",
    "mcp:test-client": "npm run build && node dist/mcp/test-client.js",
    "mcp:approve": "npm run build && node dist/mcp/approve.js",
    "agent:claude": "npm run build && node dist/demo/claude-agent-demo.js",
    "context:demo": "npm run build && node dist/orchestration/demo.js",
    "test": "npm run build && node --test dist/budget/budget.test.js",
    "budget:demo": "npm run build && node dist/budget/demo.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "nanoid": "^5.0.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  }
}
